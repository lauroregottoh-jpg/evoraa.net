# URL du projet Supabase — ex: https://xxxx.supabase.co
# Ne pas ajouter /rest/v1/ à la fin.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here

# Clé anon (publique). Protégée par les policies RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# URL publique de l'app (callbacks paiement + SEO)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (optionnel — activer UN seul)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=evoraa-net.vercel.app

# Mode démo paiements. En production: false + clés Bictorys/CinetPay obligatoires.
PAYMENTS_DEMO_MODE=true
# Provider live prioritaire: bictorys | cinetpay
# PAYMENT_PROVIDER=bictorys

# Cron Vercel — rappels expiration Alliance (J-7, J-3, J-1). Générez une chaîne aléatoire.
# CRON_SECRET=

# Emails transactionnels (bienvenue, contact, relances abonnement)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=KELLIA <contact@keliaa.org>
# CONTACT_INBOX_EMAIL=lauroregottoh@gmail.com

# CinetPay (production) — notify URL générée auto avec ?token= si SECRET défini
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=

# Bictorys (production/sandbox)
# BICTORYS_API_KEY=public-xxxx.yyyy (ou test_public-xxxx.yyyy)
# BICTORYS_WEBHOOK_SECRET=secret-webhook-bictorys
# BICTORYS_MERCHANT_COUNTRY=SN
# BICTORYS_PAYMENT_MODE=mobile_money

# Service role Supabase — serveur uniquement (webhook CinetPay). Ne jamais exposer au client.
# SUPABASE_SERVICE_ROLE_KEY=

# Optionnel — URL Postgres pour les scripts de migration locaux (run_migration.ps1)
# SUPABASE_DB_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Soft launch : PAYMENTS_DEMO_MODE=true jusqu'au 1er paiement réel testé.
# Puis false + clés + webhook + Resend pour les 1000 premiers utilisateurs.

# Eva LLM (optionnel). Sans clé → moteur knowledge docs/eva local.
# OPENAI_API_KEY=sk-...
# OPENAI_EVA_MODEL=gpt-4o-mini
