# URL du projet Supabase — ex: https://xxxx.supabase.co
# Ne pas ajouter /rest/v1/ à la fin.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here

# Clé anon (publique). Protégée par les policies RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# URL publique de l'app (callbacks paiement + SEO) — domaine RÉEL : keliaa.org (pas .net)
NEXT_PUBLIC_APP_URL=https://www.keliaa.org

# Analytics (optionnel — activer UN seul)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=www.keliaa.org

# Mode démo paiements. En production: false + clés Bictorys obligatoires.
PAYMENTS_DEMO_MODE=false
# Provider live prioritaire: bictorys (recommandé) | cinetpay
PAYMENT_PROVIDER=bictorys

# Cron Vercel — rappels expiration Alliance (J-7, J-3, J-1). Générez une chaîne aléatoire.
# CRON_SECRET=

# Emails transactionnels (bienvenue, contact, relances abonnement, Alliance activée)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=KELIAA <contact@keliaa.org>
# CONTACT_INBOX_EMAIL=contact@keliaa.org

# CinetPay (fallback) — secret en HEADER x-cinetpay-secret, jamais ?token= dans l’URL
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=
# CINETPAY_WEBHOOK_TOKEN=

# Bictorys (production — primaire Keliaa)
# Clé publique live : public-XXXX.YYYY (sandbox : test_public-…)
# BICTORYS_API_KEY=public-xxxx.yyyy
# Secret webhook = chaîne que VOUS créez, identique Bictorys Dashboard ↔ Vercel
# BICTORYS_WEBHOOK_SECRET=
# BICTORYS_MERCHANT_COUNTRY=TG
# BICTORYS_PAYMENT_MODE=mobile_money
# Webhook URL à coller dans Bictorys :
#   https://www.keliaa.org/api/payments/bictorys/notify
# Voir docs/OPS_BICTORYS_LIVE.md

# Service role Supabase — serveur uniquement (webhook CinetPay). Ne jamais exposer au client.
# SUPABASE_SERVICE_ROLE_KEY=

# Optionnel — URL Postgres pour les scripts de migration locaux (run_migration.ps1)
# SUPABASE_DB_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Soft launch auth : inscription opérationnelle sans SMTP Auth Supabase
# (évite "email rate limit exceeded"). Activé par défaut.
# Mettre false uniquement quand Auth emails Supabase (ou Resend SMTP) sont fiables.
# ALLOW_SOFT_EMAIL_CONFIRM=false

# Google OAuth — activer le provider dans Supabase (Auth → Providers → Google).
# Client ID / Secret se configurent dans le dashboard Supabase, pas ici.
# Voir docs/GOOGLE_OAUTH_SETUP.md
# Redirects requis : {APP_URL}/auth/callback

# Observabilité optionnelle (Sentry DSN). Sans valeur = logs serveur uniquement.
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0


# Eva LLM (optionnel). Sans clé → moteur knowledge docs/eva local.
# OPENAI_API_KEY=sk-...
# OPENAI_EVA_MODEL=gpt-4o-mini
