# URL du projet Supabase — ex: https://xxxx.supabase.co
# Ne pas ajouter /rest/v1/ à la fin.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here

# Clé anon (publique). Protégée par les policies RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optionnel — URL Postgres pour les scripts de migration locaux (run_migration.ps1)
# SUPABASE_DB_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
